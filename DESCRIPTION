Package: TempleCBE
Type: Package
Title: Temple CBE Biostatistics, Clinical Data Science, and Modeling Utilities
Version: 0.2.0
Authors@R: 
    person("J Kyle", "Armstrong", email = "j.kyle.armstrong@gmail.com", role = c("aut", "cre"),
