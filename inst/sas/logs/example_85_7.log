64         /* 2. Transform to Counting-Process Start/Stop Data */
65         data Tumor1(keep=ID Time Dead Dose T1 T2 NPap Status);
66            array pp{*} P1-P14;
67            array qq{*} P2-P15;
68            array tt{1:15} _temporary_
69               (27 34 37 41 43 45 46 47 49 50 51 53 65 67 71);
2                                           The SAS System          13:31 Thursday, September 17, 2026

70            set Tumor;
71            T1 = 0; T2 = 0; Status = 0;
72            if ( Time = tt[1] ) then do;
73               T2 = tt[1]; NPap = p1; Status = Dead; output;
74            end;
75            else do _i_=1 to dim(pp);
76               if ( tt[_i_] = Time ) then do;
77                  T2 = Time; NPap = pp[_i_]; Status = Dead; output;
78               end;
79               else if (tt[_i_] < Time ) then do;
80                  if (pp[_i_] ^= qq[_i_] ) then do;
81                     if qq[_i_] = . then T2 = Time;
82                     else                T2 = tt[_i_];
83                     NPap = pp[_i_]; Status = 0; output;
84                     T1 = T2;
85                  end;
86               end;
87            end;
88            if ( Time >= tt[15] ) then do;
89               T2 = Time; NPap = P15; Status = Dead; output;
