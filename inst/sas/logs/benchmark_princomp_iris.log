1          /*==============================================================================
2            TempleCBE SAS Validation Benchmark: PROC PRINCOMP on Fisher's iris data
3          
4            Runs SAS PROC PRINCOMP (correlation matrix, the default) on the 150 rows of R's
5            datasets::iris, typed into this program, so that R and SAS see the very same
6            numbers (a test in test-sas_parity_reference.R checks the datalines). The
7            eigenvalue table SAS prints is compared with TempleCBE::proc_pca() in the
8            package tests; the numbers are in tests/testthat/reference/sas_princomp_iris.csv.
9          
10           Can be executed directly from R:
11             TempleCBE::run_sas_script(
12               TempleCBE::cbe_sas_macro_path("benchmark_princomp_iris.sas")
13             )
14         ==============================================================================*/
15         
16         options nodate nonumber linesize=100 pagesize=60;
17         
18         data work.iris;
19             infile datalines dsd missover;
20             length sepal_length sepal_width petal_length petal_width 8 species $ 10;
21             input sepal_length sepal_width petal_length petal_width species $;
22         datalines;

NOTE: The data set WORK.IRIS has 150 observations and 5 variables.
NOTE: DATA statement used (Total process time):
      real time           0.25 seconds
      cpu time            0.03 seconds
      

173        ;
174        run;
175        
176        title "PROC PRINCOMP on the 150 iris rows (correlation matrix)";
177        proc princomp data=work.iris;
178            var sepal_length sepal_width petal_length petal_width;
