1          /*==============================================================================
2            TempleCBE SAS Validation Benchmark: NCCTG Lung Cancer Brier Score & IBS
3          
4            Demonstrates exact numerical concordance of IPCW Brier Score and
5            Integrated Brier Score (IBS) between SAS PROC PHREG / %cbe_brier_score
6            and TempleCBE (R).
7          
8            Can be executed directly from R:
9              TempleCBE::run_sas_script(
10               TempleCBE::cbe_sas_macro_path("benchmark_brier_lung.sas")
11             )
12         ==============================================================================*/
13         
14         /* 1. Set SAS macro search path or define macros */
15         %let script_dir = %sysfunc(tranwrd(%sysfunc(getoption(sysin)), benchmark_brier_lung.sas,
15       ! %str()));
16         %if %length(&script_dir) > 0 %then %do;
17             %include "&script_dir/cbe_brier_score.sas";
347            %include "&script_dir/cbe_cox_phreg.sas";
471        %end;
472        
473        /* 2. Load or transcribe NCCTG Lung Dataset */
474        data work.lung;
475            infile datalines dsd missover;
476            length inst 8 time 8 status 8 age 8 sex 8 ph_ecog 8 ph_karno 8 pat_karno 8 meal_cal 8
476      ! wt_loss 8;
477            input inst time status age sex ph_ecog ph_karno pat_karno meal_cal wt_loss;
478            /* Recode status: NCCTG has 1=censored, 2=dead. Recode to 0=censored, 1=dead */
479            if status = 2 then event = 1;
480            else if status = 1 then event = 0;
481            else delete;
2                                           The SAS System          13:32 Thursday, September 17, 2026

482            if missing(ph_karno) then delete;
483        datalines;

NOTE: The data set WORK.LUNG has 31 observations and 11 variables.
NOTE: DATA statement used (Total process time):
      real time           0.02 seconds
      cpu time            0.01 seconds
      

515        ;
516        run;
517        
518        /* 3. Run Cox PHREG Model */
519        %cbe_cox_phreg(
520            data       = work.lung,
521            time       = time,
522            status     = event,
523            vars       = age sex ph_karno,
524            ties       = BRESLOW,
525            out_est    = work.lung_estimates,
526            out_fit    = work.lung_fit
527        );
