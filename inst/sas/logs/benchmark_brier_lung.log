1          /*==============================================================================
2            TempleCBE SAS Validation Benchmark: NCCTG Lung Cancer Brier Score & IBS
3          
4            Runs SAS PROC PHREG / %cbe_brier_score on 31 lung-cancer subjects; the
5            results are compared with TempleCBE (R) in the package tests. All three
6            censoring times are after day 500, so every censoring weight is 1 here:
7            benchmark_brier_lung_full.sas is the benchmark that exercises the weights.
8          
9            Can be executed directly from R:
10             TempleCBE::run_sas_script(
11               TempleCBE::cbe_sas_macro_path("benchmark_brier_lung.sas")
12             )
13         ==============================================================================*/
14         
15         /* 1. Set SAS macro search path or define macros */
16         %let script_dir = %sysfunc(tranwrd(%sysfunc(getoption(sysin)), benchmark_brier_lung.sas,
16       ! %str()));
17         %if %length(&script_dir) > 0 %then %do;
18             %include "&script_dir/cbe_brier_score.sas";
363            %include "&script_dir/cbe_cox_phreg.sas";
487        %end;
488        
489        /* 2. Load or transcribe NCCTG Lung Dataset */
490        data work.lung;
491            infile datalines dsd missover;
492            length inst 8 time 8 status 8 age 8 sex 8 ph_ecog 8 ph_karno 8 pat_karno 8 meal_cal 8
492      ! wt_loss 8;
493            input inst time status age sex ph_ecog ph_karno pat_karno meal_cal wt_loss;
494            /* Recode status: NCCTG has 1=censored, 2=dead. Recode to 0=censored, 1=dead */
495            if status = 2 then event = 1;
496            else if status = 1 then event = 0;
2                                           The SAS System           22:11 Tuesday, September 29, 2026

497            else delete;
498            if missing(ph_karno) then delete;
499        datalines;

NOTE: The data set WORK.LUNG has 31 observations and 11 variables.
NOTE: DATA statement used (Total process time):
      real time           0.02 seconds
      cpu time            0.01 seconds
      

531        ;
532        run;
533        
534        /* 3. Run Cox PHREG Model */
535        %cbe_cox_phreg(
536            data       = work.lung,
537            time       = time,
538            status     = event,
539            vars       = age sex ph_karno,
540            ties       = BRESLOW,
541            out_est    = work.lung_estimates,
542            out_fit    = work.lung_fit
543        );
