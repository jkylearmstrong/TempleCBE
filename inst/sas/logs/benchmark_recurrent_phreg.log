187        /* 4. Andersen-Gill fit: total (study) time, one baseline hazard.
188           COVS(AGGREGATE) + ID id gives the robust sandwich standard errors
189           that recurrent_cox() reports; COVM adds the model-based table. */
190        title1 "Recurrent PHREG -- Andersen-Gill (total time): COVS(AGGREGATE) COVM";
191        ods output ParameterEstimates=work.phreg_ag_est;
192        proc phreg data=work.cgd_r covs(aggregate) covm;
193            model (tstart, tstop)*status(0) = treat sex age / ties=efron rl;
194            id id;
195        run;

