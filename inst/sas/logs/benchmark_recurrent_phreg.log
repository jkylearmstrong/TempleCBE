156        
157        /* 3. Derive the gap times and the (capped) event number from
158           (tstart, tstop, status) alone, in the same way recurrent_cox()
159           model = "pwp_gap" does in R: gap time restarts at the previous
160           event (0 before the first), and event_no is 1 + the number of
161           earlier events of the patient. enum3 pools event numbers 3 and
162           above into one stratum (44 / 17 / 15 events). */
163        proc sort data=work.cgd out=work.cgd_r;
164            by id tstart;
165        run;

NOTE: There were 203 observations read from the data set WORK.CGD.
NOTE: The data set WORK.CGD_R has 203 observations and 8 variables.
NOTE: PROCEDURE SORT used (Total process time):
      real time           0.00 seconds
      cpu time            0.01 seconds
      

166        
167        data work.cgd_r;
168            set work.cgd_r;
169            by id;
170            retain _prev_event 0 _n_prior 0;
171            if first.id then do;
172                _prev_event = 0;
173                _n_prior = 0;
174            end;
175            event_no = _n_prior + 1;
176            enum3 = min(event_no, 3);
177            gap_tstart = tstart - _prev_event;
178            gap_tstop = tstop - _prev_event;
179            output;
180            if status = 1 then do;
181                _prev_event = tstop;
182                _n_prior = _n_prior + 1;
183            end;
184            drop _prev_event _n_prior;
185        run;

NOTE: There were 203 observations read from the data set WORK.CGD_R.
NOTE: The data set WORK.CGD_R has 203 observations and 12 variables.
