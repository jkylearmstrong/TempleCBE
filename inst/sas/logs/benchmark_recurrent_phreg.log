202        /* 5. Prentice-Williams-Peterson gap-time fit: gap time since the
203           previous infection, baseline hazard per event number (1, 2, 3+). */
204        title1 "Recurrent PHREG -- PWP gap time: COVS(AGGREGATE) COVM";
205        ods output ParameterEstimates=work.phreg_gap_est;
206        proc phreg data=work.cgd_r covs(aggregate) covm;
207            model (gap_tstart, gap_tstop)*status(0) = treat sex age / ties=efron rl;
