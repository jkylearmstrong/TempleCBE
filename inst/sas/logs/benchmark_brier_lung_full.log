752            eval_times = 100 200 300 400 500,
753            ties       = BRESLOW,
754            trunc      = 0.05,
755            out_brier  = work.lung_brier,
756            out_ibs    = work.lung_ibs,
757            out_calib  = work.lung_calib
758        );
