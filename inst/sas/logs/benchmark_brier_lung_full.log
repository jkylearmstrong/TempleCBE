1          /*==============================================================================
2            TempleCBE SAS Validation Benchmark: Full NCCTG Lung Cancer Cohort (survival::lung)
3            IPCW Brier Score & Integrated Brier Score with real censoring
4          
5            The same analysis as benchmark_brier_lung.sas, on all 228 rows of
6            survival::lung (227 after dropping the row with missing ph_karno). 49 of the
7            227 subjects are censored by day 500, so, unlike the 31-subject benchmark,
8            this one exercises the IPCW weights G(t) and G(T_i-) of %cbe_brier_score.
9          
10           The datalines below are survival::lung as it ships with the R package
11           survival (status 1 = censored, 2 = dead; NA written as .).
12         
13           Can be executed directly from R:
14             TempleCBE::run_sas_script(
15               TempleCBE::cbe_sas_macro_path("benchmark_brier_lung_full.sas")
16             )
17         ==============================================================================*/
18         
19         /* 1. Set SAS macro search path or define macros */
20         %let script_dir = %sysfunc(tranwrd(%sysfunc(getoption(sysin)),
20       ! benchmark_brier_lung_full.sas, %str()));
21         %if %length(&script_dir) > 0 %then %do;
22             %include "&script_dir/cbe_brier_score.sas";
367            %include "&script_dir/cbe_cox_phreg.sas";
491        %end;
492        
493        /* 2. Load or transcribe NCCTG Lung Dataset (survival::lung) */
494        data work.lung;
495            infile datalines dsd missover;
496            length inst 8 time 8 status 8 age 8 sex 8 ph_ecog 8 ph_karno 8 pat_karno 8 meal_cal 8
496      ! wt_loss 8;
2                                           The SAS System           22:11 Tuesday, September 29, 2026

497            input inst time status age sex ph_ecog ph_karno pat_karno meal_cal wt_loss;
498            /* Recode status: NCCTG has 1=censored, 2=dead. Recode to 0=censored, 1=dead */
499            if status = 2 then event = 1;
500            else if status = 1 then event = 0;
501            else delete;
502            if missing(ph_karno) then delete;
503        datalines;

NOTE: The data set WORK.LUNG has 227 observations and 11 variables.
NOTE: DATA statement used (Total process time):
      real time           0.01 seconds
      cpu time            0.03 seconds
      

732        ;
733        run;
734        
735        /* 3. Run Cox PHREG Model */
736        %cbe_cox_phreg(
737            data       = work.lung,
738            time       = time,
739            status     = event,
740            vars       = age sex ph_karno,
741            ties       = BRESLOW,
742            out_est    = work.lung_estimates,
743            out_fit    = work.lung_fit
744        );
