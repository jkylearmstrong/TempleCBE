{
  "name": "master",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "merge"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "ubuntu-latest (release)",
            "integration_id": null
          },
          {
            "context": "ubuntu-24.04-arm (release)",
            "integration_id": null
          },
          {
            "context": "macOS-latest (release)",
            "integration_id": null
          },
          {
            "context": "windows-latest (release)",
            "integration_id": null
          },
          {
            "context": "optional-tests-ubuntu-latest",
            "integration_id": null
          },
          {
            "context": "optional-tests-ubuntu-24.04-arm",
            "integration_id": null
          },
          {
            "context": "optional-tests-windows-latest",
            "integration_id": null
          },
          {
            "context": "test-coverage",
            "integration_id": null
          }
        ]
      }
    }
  ]
}
